{
  "name": "memosync",
  "version": "0.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "docker:start": "docker compose -f .devcontainer/docker-compose.yml up -d",
    "docker:stop": "docker compose -f .devcontainer/docker-compose.yml down",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{js,ts,tsx,jsx}\"",
    "lint:fix": "eslint --fix \"**/*.{js,ts,tsx,jsx}\"",
    "lint:check": "eslint \"**/*.{js,ts,tsx,jsx}\"",
    "lint-staged": "lint-staged",
    "commit": "git-cz",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write --parser=typescript"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soberzen/memoSync.git"
  },
  "keywords": [],
  "packageManager": "pnpm@11.1.1",
  "author": "sober",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "catalog:",
    "commitizen": "^4.3.1",
    "commitlint": "^21.0.1",
    "cz-git": "^1.13.1",
    "eslint": "9.36.0",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-sonarjs": "3.0.5",
    "eslint-plugin-unicorn": "61.0.2",
    "globals": "16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "3.8.3",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.10.7",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.1.1"
  }
}
